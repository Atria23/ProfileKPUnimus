{
    "version": 2,
  
    "functions": {
      "api/index.php": {
        "runtime": "vercel-php@0.7.2"
      }
    },
  
    "builds": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
          },
          {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
          },
          {
            "src": "/favicon.png",
            "dest": "/public/favicon.png"
          },
          {
            "src": "/(.*)",
            "dest": "/api/index.php"
          }
    ],
  
    "routes": [
      {
        "src": "/build/(.*)",
        "dest": "/public/build/$1"
      },
      {
        "src": "/favicon.ico",
        "dest": "/public/favicon.ico"
      },
      {
        "src": "/favicon.png",
        "dest": "/public/favicon.png"
      },
      {
        "src": "/(.*)",
        "dest": "/api/index.php"
      }
    ]
  }